{
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devPath": "http://localhost:5173",
    "distDir": "../frontend/dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Fragile Notes",
    "version": "0.5.7"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "scope": ["$HOME/**", "$DOCUMENT/**", "$RESOURCE/**"]
      },
      "path": { "all": true },
      "dialog": { "all": true, "open": true, "save": true },
      "shell": { "open": true }
    },
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/freakkxd/Fragile-Notes/releases/latest/download/updater.json"],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEQjhFNTIyOTYyM0QwQjUKUldTMTBDT1dJdVc0blZpc0YrVWxBcjQxUUE0KzJLbWNZUWljWDRZNFN0SE9meVNxZlZuU0N0TkUK"
    },
    "bundle": {
      "active": true,
      "category": "Productivity",
      "copyright": "© 2026 Fragilich",
      "identifier": "com.fragilich.notes",
      "icon": ["icons/icon.ico", "icons/icon.png"],
      "targets": ["appimage", "deb", "nsis", "msi", "updater"],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "nsis": {
          "displayLanguageSelector": false,
          "installMode": "both",
          "installerIcon": "icons/icon.ico",
          "languages": ["Russian", "English"],
          "template": null
        },
        "wix": {
          "language": ["ru-RU", "en-US"],
          "template": null
        }
      }
    },
    "security": { "csp": null },
    "windows": [{ "title": "Fragile Notes — Obsidian-like", "width": 1280, "height": 800, "resizable": true, "fullscreen": false, "visible": true }]
  }
}
