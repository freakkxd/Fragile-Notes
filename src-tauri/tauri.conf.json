{
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "beforeBuildCommand": "npm run build --prefix ../frontend",
    "devPath": "http://localhost:5173",
    "distDir": "../frontend/dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Fragile Notes",
    "version": "0.4.5"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "scope": ["$HOME/**", "$DOCUMENT/**", "$RESOURCE/**"]
      },
      "path": { "all": true },
      "dialog": { "all": true, "open": true, "save": true },
      "shell": { "open": true }
    },
    "bundle": {
      "active": true,
      "category": "Productivity",
      "copyright": "© 2026 Fragilich",
      "identifier": "com.fragilich.notes",
      "icon": ["icons/icon.png"],
      "targets": ["nsis", "msi"],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "nsis": {
          "displayLanguageSelector": false,
          "installMode": "both",
          "installerIcon": "icons/icon.png",
          "languages": ["Russian", "English"],
          "startMenuFolder": "Fragile Notes",
          "template": null
        },
        "wix": {
          "language": ["ru-RU", "en-US"],
          "template": null
        }
      }
    },
    "security": { "csp": null },
    "windows": [{ "title": "Fragile Notes — Obsidian-like", "width": 1280, "height": 800, "resizable": true, "fullscreen": false, "visible": true }]
  }
}
